# ==============================================================================
# Forafa-App — Environment Configuration (PHP Native + MySQL)
# ==============================================================================

# Database Connection (Default Laragon / XAMPP: host=127.0.0.1, user=root, password kosong)
# Jika menggunakan Cloud Database (Aiven/Clever Cloud/Railway): sesuaikan host, port, user, password, database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=forafa_db
DB_USERNAME=root
DB_PASSWORD=

# JWT & Session Authentication
JWT_SECRET=forafa_secret_key_native_php_2026_change_in_production
JWT_EXPIRE_MINUTES=1440
SESSION_LIFETIME_MINUTES=1440
SESSION_IDLE_MINUTES=120
SESSION_REGENERATE_ON_LOGIN=true

# Google OAuth 2.0 (Google Sign-In & 1-Vote-Per-Google-Account)
GOOGLE_CLIENT_ID=forafa-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email OTP — Verifikasi pendaftaran akun via email (Gmail SMTP)
# Pengirim kode: forafagroup@gmail.com
# CARA MENGISI (lihat docs/email-otp-setup.md):
# 1. Aktifkan verifikasi 2 langkah di akun Google forafagroup@gmail.com
#    (myaccount.google.com > Security > 2-Step Verification).
# 2. Di halaman yang sama, buka "App passwords", buat App Password baru
#    (nama mis. "Forafa-App"), salin kode 16 karakternya.
# 3. Isi MAIL_USERNAME dengan forafagroup@gmail.com dan MAIL_APP_PASSWORD
#    dengan kode 16 karakter itu (TANPA spasi). Jangan isi password akun
#    Gmail biasa — Gmail menolaknya untuk SMTP.
# 4. Restart server PHP (php -S localhost:8000 router.php).
MAIL_FROM_ADDRESS=forafagroup@gmail.com
MAIL_FROM_NAME="Forafa-App"
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=forafagroup@gmail.com
MAIL_APP_PASSWORD=your_gmail_app_password_16_chars
# Kode OTP: 5 digit, berlaku 10 menit, maks. 3x salah, kirim ulang 60 detik.
EMAIL_OTP_EXPIRE_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=3
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_OTP_TOKEN_EXPIRE_MINUTES=15

# WhatsApp OTP Gateway (Verifikasi nomor & 1-Vote-Per-WhatsApp)
WHATSAPP_PROVIDER=mock
WHATSAPP_API_KEY=your_fonnte_or_wablas_api_key
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Rate Limiting & Anti-Spam
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_MAX=60
RATE_LIMIT_SUBMIT_MAX=5
RATE_LIMIT_OTP_MAX=3
SPAM_HONEYPOT_ENABLED=true
SPAM_MIN_SUBMIT_SECONDS=1

# App Settings
APP_NAME="Forafa-App Backend API"
APP_ENV=development
API_PREFIX=/api/v1

# CORS Allowed Origins (pisahkan dengan koma jika lebih dari satu, atau gunakan * untuk semua)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Cloud Storage (Fitur Nilai Tambah - Supabase Storage / Cloudinary)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your_supabase_anon_or_service_key
