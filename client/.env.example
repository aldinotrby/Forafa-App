# Google Sign-In Configuration (Login dengan Google)
# 1. Buka https://console.cloud.google.com/apis/credentials
# 2. Buat OAuth 2.0 Client ID bertipe "Web application"
# 3. Tambahkan origin aplikasi ke "Authorized JavaScript origins",
#    contoh: http://localhost:5173
# 4. Salin Client ID-nya ke variabel di bawah ini, lalu restart `npm run dev`
VITE_GOOGLE_CLIENT_ID=963791095328-ka2d7qb4nl8501gul4vfj9ak2gsqtlee.apps.googleusercontent.com

# Cloudinary Configuration for Media Upload
# Get these values from https://cloudinary.com (Free tier available)

# Your Cloudinary cloud name (found in dashboard)
VITE_CLOUDINARY_CLOUD_NAME=iexolkoc

# Unsigned upload preset (create in Cloudinary dashboard > Settings > Upload)
VITE_CLOUDINARY_UPLOAD_PRESET=forafa_cloudinary

# Optional: API Key (for advanced features)
VITE_CLOUDINARY_API_KEY=422482143934581
