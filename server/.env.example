# ==============================================================================
# Forafa-App — Environment Configuration (PHP Native + MySQL)
# ==============================================================================

# Database Connection (Default Laragon / XAMPP: host=127.0.0.1, user=root, password kosong)
# Jika menggunakan Cloud Database (Aiven/Clever Cloud/Railway): sesuaikan host, port, user, password, database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=forafa_db
DB_USERNAME=root
DB_PASSWORD=

# JWT Authentication
# Gunakan string rahasia yang panjang dan unik di environment production
JWT_SECRET=forafa_secret_key_native_php_2026_change_in_production
JWT_EXPIRE_MINUTES=1440

# App Settings
APP_NAME="Forafa-App Backend API"
APP_ENV=development
API_PREFIX=/api/v1

# CORS Allowed Origins (pisahkan dengan koma jika lebih dari satu, atau gunakan * untuk semua)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Cloud Storage (Fitur Nilai Tambah - Supabase Storage / Cloudinary)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your_supabase_anon_or_service_key
